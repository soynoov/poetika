---

type Props = {
	currentPath?: string;
};

const { currentPath = '/' } = Astro.props as Props;

const navItems = [
	{ href: '/', label: 'Inicio' },
	{ href: '/write', label: 'Escribir' },
	{ href: '/challenge', label: 'Cima' },
	{ href: '/profile', label: 'Perfil', dynamicProfile: true },
];
---

<header class='app-header'>
	<div class='mx-auto flex max-w-[1180px] items-center justify-between gap-3 px-5 py-4 sm:px-6 lg:px-8'>
		<details class='relative md:hidden'>
			<summary
				class='app-icon-button flex h-12 w-12 cursor-pointer list-none items-center justify-center'
				aria-label='Abrir navegacion'
			>
				<svg
					viewBox='0 0 24 24'
					class='h-5 w-5'
					fill='none'
					stroke='currentColor'
					stroke-width='1.9'
					stroke-linecap='round'
					stroke-linejoin='round'
					aria-hidden='true'
				>
					<path d='M4 7h16M4 12h16M4 17h16'></path>
				</svg>
			</summary>

			<div class='app-menu-panel absolute left-0 top-[calc(100%+0.85rem)] z-30 w-[min(18rem,calc(100vw-2.5rem))] rounded-[1.6rem] p-3'>
				<nav class='flex flex-col gap-1 text-sm text-[var(--ink-soft)]'>
					{navItems.map((item) => {
						const isActive =
							item.href === '/'
								? currentPath === '/'
								: currentPath === item.href || currentPath.startsWith(`${item.href}/`);

						return (
							<a
								href={item.href}
								data-profile-link={item.dynamicProfile ? 'true' : undefined}
								class:list={[
									'app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 transition',
									isActive && 'is-active',
								]}
							>
								<span>{item.label}</span>
								<svg
									viewBox='0 0 24 24'
									class='h-4 w-4 opacity-60'
									fill='none'
									stroke='currentColor'
									stroke-width='1.9'
									stroke-linecap='round'
									stroke-linejoin='round'
									aria-hidden='true'
								>
									<path d='m9 6 6 6-6 6'></path>
								</svg>
							</a>
						);
					})}
				</nav>

				<div class='mt-3 border-t border-[var(--frame-border)] pt-3'>
					<a
						href='/auth'
						data-guest-only
						class='app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 text-sm text-[var(--ink-soft)] transition'
					>
						<span>Entrar</span>
						<svg
							viewBox='0 0 24 24'
							class='h-4 w-4 opacity-60'
							fill='none'
							stroke='currentColor'
							stroke-width='1.9'
							stroke-linecap='round'
							stroke-linejoin='round'
							aria-hidden='true'
						>
							<path d='m9 6 6 6-6 6'></path>
						</svg>
					</a>
					<div data-auth-only data-auth-display='flex' class='hidden flex-col gap-2'>
						<a
							href='/profile'
							data-profile-link='true'
							class='app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 text-sm text-[var(--ink-soft)] transition'
						>
							<span data-session-label>Mi perfil</span>
							<svg
								viewBox='0 0 24 24'
								class='h-4 w-4 opacity-60'
								fill='none'
								stroke='currentColor'
								stroke-width='1.9'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='m9 6 6 6-6 6'></path>
							</svg>
						</a>
						<a
							href='/profile'
							data-profile-settings-link='true'
							class='app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 text-sm text-[var(--ink-soft)] transition'
						>
							<span>Ajustes</span>
							<svg
								viewBox='0 0 24 24'
								class='h-4 w-4 opacity-60'
								fill='none'
								stroke='currentColor'
								stroke-width='1.9'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='m9 6 6 6-6 6'></path>
							</svg>
						</a>
						<button
							type='button'
							data-sign-out-button
							class='app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 text-left text-sm text-[var(--ink-soft)] transition'
						>
							<span>Salir</span>
							<svg
								viewBox='0 0 24 24'
								class='h-4 w-4 opacity-60'
								fill='none'
								stroke='currentColor'
								stroke-width='1.9'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='m9 6 6 6-6 6'></path>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</details>

		<div class='min-w-0 flex-1 md:flex-none'>
			<a href='/' class='app-wordmark mx-auto flex w-fit items-center gap-2.5'>
				<span class='brand-font text-[2.05rem] font-semibold leading-none tracking-[-0.04em] text-[var(--ink-strong)]'>
					Poetika
				</span>
				<span class='app-beta-tag'>Beta</span>
			</a>
		</div>

		<nav class='hidden items-center gap-3 text-sm text-[var(--muted-strong)] md:flex'>
			{navItems.map((item) => {
				const isActive =
					item.href === '/'
						? currentPath === '/'
						: currentPath === item.href || currentPath.startsWith(`${item.href}/`);

				return (
					<a
						href={item.href}
						data-profile-link={item.dynamicProfile ? 'true' : undefined}
						class:list={[
							'app-top-link rounded-full px-4 py-2 transition hover:text-[var(--ink-strong)]',
							isActive && 'is-active',
						]}
					>
						{item.label}
					</a>
				);
			})}
		</nav>

		<div class='flex items-center gap-2 md:gap-3'>
			<span
				data-session-state
				class='hidden rounded-full border border-[var(--frame-border)] bg-[var(--surface-strong)] px-3 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--ink-muted)] lg:inline-flex'
			>
				Sesion cerrada
			</span>
			<a
				href='/auth'
				data-guest-only
				class='app-icon-button hidden h-11 min-w-11 items-center justify-center rounded-full px-4 text-sm font-semibold text-[var(--ink-strong)] md:inline-flex'
			>
				Entrar
			</a>
			<details data-auth-only data-auth-display='block' class='relative hidden max-md:hidden'>
				<summary class='app-icon-button flex h-11 cursor-pointer list-none items-center gap-2 rounded-full px-4 text-sm font-semibold text-[var(--ink-strong)]'>
					<span data-session-label>Mi perfil</span>
					<svg
						viewBox='0 0 24 24'
						class='h-4 w-4 opacity-70'
						fill='none'
						stroke='currentColor'
						stroke-width='1.9'
						stroke-linecap='round'
						stroke-linejoin='round'
						aria-hidden='true'
					>
						<path d='m7 10 5 5 5-5'></path>
					</svg>
				</summary>

				<div class='app-menu-panel absolute right-0 top-[calc(100%+0.85rem)] z-30 w-64 rounded-[1.6rem] p-3'>
					<nav class='flex flex-col gap-1 text-sm text-[var(--ink-soft)]'>
						<a
							href='/profile'
							data-profile-link='true'
							class='app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 transition'
						>
							<span>Mi perfil</span>
							<svg
								viewBox='0 0 24 24'
								class='h-4 w-4 opacity-60'
								fill='none'
								stroke='currentColor'
								stroke-width='1.9'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='m9 6 6 6-6 6'></path>
							</svg>
						</a>
						<a
							href='/profile'
							data-profile-settings-link='true'
							class='app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 transition'
						>
							<span>Ajustes</span>
							<svg
								viewBox='0 0 24 24'
								class='h-4 w-4 opacity-60'
								fill='none'
								stroke='currentColor'
								stroke-width='1.9'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='m9 6 6 6-6 6'></path>
							</svg>
						</a>
						<button
							type='button'
							data-sign-out-button
							class='app-menu-link flex items-center justify-between rounded-2xl px-4 py-3 text-left transition'
						>
							<span>Salir</span>
							<svg
								viewBox='0 0 24 24'
								class='h-4 w-4 opacity-60'
								fill='none'
								stroke='currentColor'
								stroke-width='1.9'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='m9 6 6 6-6 6'></path>
							</svg>
						</button>
					</nav>
				</div>
			</details>

			<a
				href='/auth'
				data-profile-link='true'
				class='app-icon-button inline-flex h-12 w-12 items-center justify-center text-[var(--ink-strong)] md:hidden'
				aria-label='Perfil'
			>
				<svg
					viewBox='0 0 24 24'
					class='h-5 w-5'
					fill='none'
					stroke='currentColor'
					stroke-width='1.9'
					stroke-linecap='round'
					stroke-linejoin='round'
					aria-hidden='true'
				>
					<path d='M12 12a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 12 12Z'></path>
					<path d='M6 20a6 6 0 0 1 12 0'></path>
				</svg>
			</a>
		</div>
	</div>
</header>
