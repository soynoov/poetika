---
import Layout from '../layouts/Layout.astro';
import { getFallbackDailyChallenge } from '../lib/challenge';
import { getChallengeIcon } from '../lib/challenge-icons';

const challenge = getFallbackDailyChallenge();

const bottomNavItems = [
  { href: '/', label: 'Inicio', active: false, icon: 'M3 11.5 12 4l9 7.5M6.5 10.5V20h11V10.5' },
  { href: '/write', label: 'Escribir', active: true, icon: 'M4 6.5h10M4 11.5h10M4 16.5h6M16 14l4-4m0 0 2 2m-2-2-2-2' },
  { href: '/challenge', label: 'Cima', active: false, icon: 'M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm0-8v3l2 1' },
  { href: '/profile', label: 'Perfil', active: false, dynamicProfile: true, icon: 'M12 12a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 12 12Zm-6 8a6 6 0 0 1 12 0Z' },
];
---

<Layout
  title='Poetika - Editor'
  description='Escribe y publica tu relato del reto diario en una experiencia de editor mobile-first.'
>
  <main class='home-screen min-h-screen' data-write-page>
    <div class='mx-auto flex min-h-screen max-w-[1180px] flex-col px-5 pb-30 pt-5 sm:px-6 lg:px-8'>
      <header class='write-topbar'>
        <div class='flex items-center gap-4'>
          <a href='/' class='app-icon-button flex h-12 w-12 items-center justify-center' aria-label='Volver al inicio'>
            <svg
              viewBox='0 0 24 24'
              class='h-5 w-5'
              fill='none'
              stroke='currentColor'
              stroke-width='1.9'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <path d='m15 18-6-6 6-6'></path>
              <path d='M9 12h10'></path>
            </svg>
          </a>
          <div>
            <h1 class='write-title'>Editor</h1>
            <p class='write-subtitle hidden lg:block'>Escribe con el reto del dia siempre visible.</p>
          </div>
        </div>

        <button
          type='submit'
          form='story-form'
          data-story-submit
          class='write-publish-button'
        >
          Publicar
        </button>
      </header>

      <section class='mt-7 flex-1 lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-8'>
        <div class='write-editor-panel' data-editor-shell>
          <div class='write-challenge-strip'>
            <div class='flex items-center justify-between gap-3'>
              <p class='home-section-kicker'>Reto del dia</p>
              <svg
                viewBox='0 0 24 24'
                class='h-5 w-5 text-[#9a6fff]'
                fill='none'
                stroke='currentColor'
                stroke-width='1.9'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d='M12 3l1.3 3.7L17 8l-3.7 1.3L12 13l-1.3-3.7L7 8l3.7-1.3L12 3Zm6 9 .75 2.25L21 15l-2.25.75L18 18l-.75-2.25L15 15l2.25-.75L18 12Z'></path>
              </svg>
            </div>

            <div class='mt-4 overflow-x-auto pb-2'>
              <div class='flex min-w-max gap-3'>
                <article data-write-slot='0' class='write-chip-card'>
                  <div class='write-chip-icon'>
                    <svg
                      viewBox='0 0 24 24'
                      class='h-4 w-4'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='1.9'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      aria-hidden='true'
                    >
                      <path data-write-icon-path d={getChallengeIcon(challenge.slots[0].category).path} />
                    </svg>
                  </div>
                  <div class='min-w-0'>
                    <p data-write-category-1 class='write-chip-category'>{challenge.slots[0].category}</p>
                    <p data-write-word-1 class='write-chip-word'>{challenge.slots[0].word}</p>
                    <span data-write-marker-1 class='hidden'>{challenge.slots[0].marker}</span>
                  </div>
                </article>

                <article data-write-slot='1' class='write-chip-card'>
                  <div class='write-chip-icon'>
                    <svg
                      viewBox='0 0 24 24'
                      class='h-4 w-4'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='1.9'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      aria-hidden='true'
                    >
                      <path data-write-icon-path d={getChallengeIcon(challenge.slots[1].category).path} />
                    </svg>
                  </div>
                  <div class='min-w-0'>
                    <p data-write-category-2 class='write-chip-category'>{challenge.slots[1].category}</p>
                    <p data-write-word-2 class='write-chip-word'>{challenge.slots[1].word}</p>
                    <span data-write-marker-2 class='hidden'>{challenge.slots[1].marker}</span>
                  </div>
                </article>

                <article data-write-slot='2' class='write-chip-card'>
                  <div class='write-chip-icon'>
                    <svg
                      viewBox='0 0 24 24'
                      class='h-4 w-4'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='1.9'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      aria-hidden='true'
                    >
                      <path data-write-icon-path d={getChallengeIcon(challenge.slots[2].category).path} />
                    </svg>
                  </div>
                  <div class='min-w-0'>
                    <p data-write-category-3 class='write-chip-category'>{challenge.slots[2].category}</p>
                    <p data-write-word-3 class='write-chip-word'>{challenge.slots[2].word}</p>
                    <span data-write-marker-3 class='hidden'>{challenge.slots[2].marker}</span>
                  </div>
                </article>
              </div>
            </div>
          </div>

          <div data-published-state class='hidden write-state-card mt-8'>
            <p class='home-section-kicker'>Reto completado</p>
            <h2 data-published-title class='write-complete-title mt-4'>Ya has publicado tu pagina de hoy.</h2>
            <p data-published-message class='write-complete-copy mt-4'>
              Vuelve manana con el siguiente reto.
            </p>

            <div class='mt-6 flex flex-wrap gap-3'>
              <div class='write-complete-chip'>
                <p data-published-category-1 class='write-chip-category'>{challenge.slots[0].category}</p>
                <p data-published-word-1 class='write-chip-word'>{challenge.slots[0].word}</p>
              </div>
              <div class='write-complete-chip'>
                <p data-published-category-2 class='write-chip-category'>{challenge.slots[1].category}</p>
                <p data-published-word-2 class='write-chip-word'>{challenge.slots[1].word}</p>
              </div>
              <div class='write-complete-chip'>
                <p data-published-category-3 class='write-chip-category'>{challenge.slots[2].category}</p>
                <p data-published-word-3 class='write-chip-word'>{challenge.slots[2].word}</p>
              </div>
            </div>

            <div class='mt-6 flex flex-col gap-3 sm:flex-row'>
              <a href='/all' class='home-primary-button inline-flex items-center justify-center px-7 py-3 text-sm font-semibold uppercase tracking-[0.08em]'>
                Ver relatos
              </a>
              <a href='/profile' data-profile-link='true' class='home-secondary-button inline-flex items-center justify-center rounded-full px-7 py-3 text-sm font-semibold uppercase tracking-[0.08em]'>
                Mi perfil
              </a>
            </div>
          </div>

          <div data-compose-state>
            <form id='story-form' data-story-form class='mt-8 flex min-h-[52vh] flex-col'>
              <div class='write-meta-row'>
                <div class='write-meta-card'>
                  <p class='write-meta-label'>Autor</p>
                  <p data-write-author class='write-meta-value'>Entrar para publicar</p>
                </div>
                <div class='write-meta-card'>
                  <p class='write-meta-label'>Palabras</p>
                  <p id='word-count' data-word-count class='write-meta-value'>0</p>
                </div>
              </div>

              <label class='mt-7 block flex-1'>
                <span class='sr-only'>Cuerpo del relato</span>
                <textarea
                  data-story-body
                  rows='16'
                  placeholder='Comienza a escribir aqui... Deja que los elementos del reto guien tu pluma.'
                  class='write-editor-input'
                ></textarea>
              </label>

              <div class='mt-6 space-y-3'>
                <p data-required-words-status class='write-status-copy'>
                  Tu pagina debe integrar estas 3 palabras.
                </p>
                <p data-save-status class='write-status-copy text-[var(--ink-muted)]'>
                  El borrador se guarda automaticamente en este navegador.
                </p>
              </div>
            </form>

            <div data-auth-gate class='write-auth-gate mt-5'>
              Necesitas una cuenta para publicar o votar.
              <a href='/auth' class='font-semibold text-[var(--ink-strong)] underline underline-offset-4'>
                Entrar o crear cuenta
              </a>
            </div>
          </div>
        </div>

        <aside class='hidden lg:block'>
          <div class='write-side-panel'>
            <p class='home-section-kicker'>Sesion</p>
            <p class='mt-4 text-sm leading-7 text-[var(--ink-soft)]'>
              Un relato por dia. El editor guarda borrador local y valida que uses las tres palabras del reto.
            </p>

            <div class='mt-6 grid gap-3'>
              <div class='write-side-stat'>
                <span class='write-meta-label'>Fecha</span>
                <span data-write-date class='write-side-value'>{challenge.dateKey}</span>
              </div>
              <div class='write-side-stat'>
                <span class='write-meta-label'>Resumen</span>
                <span data-write-summary class='write-side-value'>{challenge.summary}</span>
              </div>
              <div class='write-side-stat'>
                <span class='write-meta-label'>Fuente</span>
                <span data-write-source class='write-side-value'>seleccion local diaria</span>
              </div>
            </div>
          </div>

        </aside>
      </section>

      <section class='mt-10'>
        <div class='mb-5 flex items-end justify-between gap-4'>
          <div>
            <p class='home-section-kicker'>Publicados</p>
            <h3 class='write-feed-title mt-2'>Relatos de hoy</h3>
          </div>
          <a href='/all' class='home-inline-link'>Ver todos</a>
        </div>
        <div data-story-list class='grid gap-4'></div>
      </section>

      <nav class='home-bottom-nav md:hidden' aria-label='Navegacion principal'>
        {
          bottomNavItems.map((item) => (
            <a
              href={item.href}
              data-profile-link={item.dynamicProfile ? 'true' : undefined}
              class:list={['home-bottom-link', item.active && 'is-active']}
            >
              <svg
                viewBox='0 0 24 24'
                class='h-5 w-5'
                fill='none'
                stroke='currentColor'
                stroke-width='1.9'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d={item.icon}></path>
              </svg>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </main>

  <script>
    import { initWriteStory } from '../scripts/write-story.ts';
    initWriteStory();
  </script>
</Layout>
