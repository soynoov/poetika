---
import AppHeader from '../components/AppHeader.astro';
import Layout from '../layouts/Layout.astro';

const bottomNavItems = [
  { href: '/', label: 'Inicio', active: false, icon: 'M3 11.5 12 4l9 7.5M6.5 10.5V20h11V10.5' },
  { href: '/write', label: 'Escribir', active: false, icon: 'M4 6.5h10M4 11.5h10M4 16.5h6M16 14l4-4m0 0 2 2m-2-2-2-2' },
  { href: '/all', label: 'Cima', active: true, icon: 'M5 19h14M7 17V9h3v8H7Zm7 0V5h3v12h-3Z' },
  { href: '/profile', label: 'Perfil', active: false, dynamicProfile: true, icon: 'M12 12a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 12 12Zm-6 8a6 6 0 0 1 12 0Z' },
];
---

<Layout
  title='Poetika - Ranking'
  description='Ranking global de autoras y autores de Poetika.'
>
  <main class='home-screen min-h-screen' data-leaderboard-page>
    <div class='mx-auto max-w-[1180px] px-0 pb-30 sm:px-6 lg:px-8'>
      <AppHeader currentPath='/challenge' />

      <section class='mx-auto max-w-[1100px] px-5 pb-10 pt-7 sm:px-6'>
        <section class='leaderboard-podium-grid'>
          <article data-podium-card='0' class='leaderboard-podium-card leaderboard-podium-card-side leaderboard-podium-card-left'>
            <div class='leaderboard-podium-avatar-shell leaderboard-podium-avatar-shell-side'>
              <img data-podium-avatar class='leaderboard-podium-avatar hidden' alt='Avatar del ranking' />
              <div data-podium-fallback class='leaderboard-podium-fallback'>P</div>
              <span data-podium-rank class='leaderboard-podium-rank'>2</span>
            </div>
            <div class='leaderboard-podium-info'>
              <p data-podium-highlight class='leaderboard-podium-title'>Virtuoso</p>
              <h2 data-podium-name class='leaderboard-podium-name'>...</h2>
              <p data-podium-points class='leaderboard-podium-points'>0 pts</p>
            </div>
          </article>

          <article data-podium-card='1' class='leaderboard-podium-card leaderboard-podium-card-center'>
            <div class='leaderboard-podium-avatar-shell leaderboard-podium-avatar-shell-center'>
              <img data-podium-avatar class='leaderboard-podium-avatar hidden' alt='Avatar del ranking' />
              <div data-podium-fallback class='leaderboard-podium-fallback'>P</div>
              <span data-podium-rank class='leaderboard-podium-rank'>1</span>
            </div>
            <div class='leaderboard-podium-info'>
              <p data-podium-highlight class='leaderboard-podium-title'>Autor coronado</p>
              <h2 data-podium-name class='leaderboard-podium-name'>...</h2>
              <p data-podium-points class='leaderboard-podium-points'>0 pts</p>
            </div>
          </article>

          <article data-podium-card='2' class='leaderboard-podium-card leaderboard-podium-card-side leaderboard-podium-card-right'>
            <div class='leaderboard-podium-avatar-shell leaderboard-podium-avatar-shell-side'>
              <img data-podium-avatar class='leaderboard-podium-avatar hidden' alt='Avatar del ranking' />
              <div data-podium-fallback class='leaderboard-podium-fallback'>P</div>
              <span data-podium-rank class='leaderboard-podium-rank'>3</span>
            </div>
            <div class='leaderboard-podium-info'>
              <p data-podium-highlight class='leaderboard-podium-title'>Sage</p>
              <h2 data-podium-name class='leaderboard-podium-name'>...</h2>
              <p data-podium-points class='leaderboard-podium-points'>0 pts</p>
            </div>
          </article>
        </section>

        <section class='mt-10'>
          <div class='leaderboard-topline'>
            <p class='leaderboard-kicker'>Literary ascension</p>
            <div class='leaderboard-tabs'>
              <button type='button' class='leaderboard-tab is-active'>Global</button>
              <button type='button' class='leaderboard-tab is-disabled'>Amigos</button>
            </div>
          </div>

          <p class='leaderboard-meta mt-3'>
            <span data-leaderboard-total>0</span> autoras y autores clasificados con datos reales de relatos y likes.
          </p>

          <div data-leaderboard-list class='mt-6 grid gap-4'></div>
        </section>
      </section>

      <nav class='home-bottom-nav md:hidden' aria-label='Navegacion principal'>
        {
          bottomNavItems.map((item) => (
            <a
              href={item.href}
              data-profile-link={item.dynamicProfile ? 'true' : undefined}
              class:list={['home-bottom-link', item.active && 'is-active']}
            >
              <svg
                viewBox='0 0 24 24'
                class='h-5 w-5'
                fill='none'
                stroke='currentColor'
                stroke-width='1.9'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d={item.icon}></path>
              </svg>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </main>

  <script>
    import { initLeaderboardPage } from '../scripts/leaderboard.ts';

    initLeaderboardPage();
  </script>
</Layout>
