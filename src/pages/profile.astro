---
import AppHeader from '../components/AppHeader.astro';
import Layout from '../layouts/Layout.astro';

const bottomNavItems = [
  { href: '/', label: 'Inicio', active: false, icon: 'M3 11.5 12 4l9 7.5M6.5 10.5V20h11V10.5' },
  { href: '/write', label: 'Escribir', active: false, icon: 'M4 6.5h10M4 11.5h10M4 16.5h6M16 14l4-4m0 0 2 2m-2-2-2-2' },
  { href: '/challenge', label: 'Cima', active: false, icon: 'M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm0-8v3l2 1' },
  { href: '/profile', label: 'Perfil', active: true, dynamicProfile: true, icon: 'M12 12a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 12 12Zm-6 8a6 6 0 0 1 12 0Z' },
];
---

<Layout
	title='Poetika - Perfil'
	description='Perfil de autora y portal de acceso de Poetika.'
>
	<main class='home-screen min-h-screen' data-profile-page>
		<div data-profile-signed-in-view class='mx-auto max-w-[1180px] px-0 pb-30 sm:px-6 lg:px-8'>
			<AppHeader currentPath='/profile' />

			<section class='mx-auto max-w-[1100px] px-5 pb-10 pt-7 sm:px-6'>
				<section data-profile-guest-card class='hidden'>
					<div class='auth-shell mx-auto flex justify-center pb-10 pt-6'>
						<div data-auth-portal class='auth-portal-card w-full max-w-[26rem]'>
							<div class='text-center'>
								<a href='/' class='auth-brand'>Poetika</a>
								<p class='auth-tagline'>Donde las palabras cobran vida</p>
							</div>

							<section data-auth-status-card data-tone='neutral' class='auth-status-banner mt-8'>
								<p data-auth-session-state class='auth-status-title'>Sesion cerrada</p>
								<p data-auth-status class='auth-status-copy'>Portal listo.</p>
								<p data-auth-hint class='auth-status-hint hidden'>
									Si la confirmacion por email esta activa, vuelve despues de verificar el correo.
								</p>
							</section>

							<div data-auth-forms class='mt-6'>
								<div class='auth-panel'>
									<div class='auth-tab-strip'>
										<button type='button' data-auth-tab-button='sign-in' class='auth-tab-button is-active'>Entrar</button>
										<button type='button' data-auth-tab-button='sign-up' class='auth-tab-button'>Registrarte</button>
									</div>

									<div data-auth-panel='sign-in' class='mt-7'>
										<form data-sign-in-form novalidate class='space-y-5'>
											<label class='block'>
												<span class='auth-field-label'>Email</span>
												<input data-sign-in-email type='email' required autocomplete='email' placeholder='tu@poema.com' class='auth-input w-full' />
											</label>
											<label class='block'>
												<div class='mb-2 flex items-center justify-between gap-3'>
													<span class='auth-field-label'>Contrasena</span>
													<button type='button' data-auth-forgot-password class='auth-helper-link'>Olvidaste?</button>
												</div>
												<input data-sign-in-password type='password' required autocomplete='current-password' placeholder='........' class='auth-input w-full' />
											</label>
											<button type='submit' class='write-publish-button w-full'>Entrar</button>
										</form>

										<div class='auth-divider'>
											<span>O continua con</span>
										</div>

										<button type='button' data-google-sign-in class='auth-google-button'>
											<span class='text-[1.4rem] leading-none text-[#ea4335]'>G</span>
											<span>Continuar con Google</span>
										</button>

										<button type='button' data-auth-switch='sign-up' class='auth-switch-link'>
											No tienes cuenta? Registrate
										</button>
									</div>

									<div data-auth-panel='sign-up' class='mt-7 hidden'>
										<form data-sign-up-form novalidate class='space-y-5'>
											<label class='block'>
												<span class='auth-field-label'>Nombre visible</span>
												<input data-sign-up-display-name type='text' required minlength='2' autocomplete='nickname' placeholder='Tu firma literaria' class='auth-input w-full' />
											</label>
											<label class='block'>
												<span class='auth-field-label'>Username</span>
												<input data-sign-up-username type='text' required minlength='3' maxlength='24' pattern='[a-z0-9_]+' autocomplete='username' placeholder='tuusername' class='auth-input w-full lowercase' />
											</label>
											<label class='block'>
												<span class='auth-field-label'>Email</span>
												<input data-sign-up-email type='email' required autocomplete='email' placeholder='tu@poema.com' class='auth-input w-full' />
											</label>
											<label class='block'>
												<span class='auth-field-label'>Contrasena</span>
												<input data-sign-up-password type='password' required minlength='6' autocomplete='new-password' placeholder='Minimo 6 caracteres' class='auth-input w-full' />
											</label>
											<button type='submit' data-sign-up-submit class='write-publish-button w-full'>
												Crear cuenta
											</button>
										</form>

										<button type='button' data-auth-switch='sign-in' class='auth-switch-link'>
											Ya tienes cuenta? Entrar
										</button>
									</div>
								</div>
							</div>

							<div class='auth-footer'>
								<div class='auth-footer-lines'>
									<span></span>
									<span></span>
								</div>
								<p>Inspiracion nocturna · 2024</p>
							</div>
						</div>
					</div>
				</section>

				<section data-profile-content>
					<header class='profile-hero'>
						<div class='profile-avatar-wrap'>
							<div class='profile-avatar-ring'>
								<img data-profile-avatar class='profile-avatar-image hidden' alt='Avatar del perfil' />
								<div data-profile-avatar-fallback class='profile-avatar-fallback'>P</div>
							</div>
							<button data-profile-avatar-trigger type='button' class='profile-avatar-edit hidden' aria-label='Cambiar foto de perfil'>
								<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
									<path d='m4 20 4.5-1L19 8.5 15.5 5 5 15.5 4 20Z'></path>
									<path d='m13.5 7 3.5 3.5'></path>
								</svg>
							</button>
						</div>

						<h1 data-profile-display-name class='profile-display-name'>Cargando perfil...</h1>
						<p data-profile-handle class='profile-handle'>@poetika</p>
						<p data-profile-bio class='profile-bio'>Todavia no ha escrito una bio en su cuaderno.</p>
						<p data-profile-status class='profile-status'></p>
					</header>

					<section class='profile-stats-grid'>
						<div class='profile-stat-card'>
							<p data-profile-total-stories class='profile-stat-value'>0</p>
							<p class='profile-stat-label'>Relatos publicados</p>
						</div>
						<div class='profile-stat-card' data-profile-streak-card data-state='idle'>
							<p data-profile-streak class='profile-stat-value'>0</p>
							<p class='profile-stat-label'>
								Racha
								<span data-profile-streak-fire class='hidden'>🔥</span>
							</p>
						</div>
					</section>

					<section class='mt-12'>
						<div class='mb-6 flex items-end justify-between gap-4'>
							<div>
								<div class='profile-library-tabs' role='tablist' aria-label='Biblioteca personal'>
									<button type='button' data-profile-tab-button='stories' class='profile-library-tab is-active' role='tab' aria-selected='true'>
										Mis paginas
									</button>
									<button type='button' data-profile-tab-button='likes' class='profile-library-tab' role='tab' aria-selected='false'>
										Paginas que me han gustado
									</button>
								</div>
							</div>
							<button type='button' class='app-icon-button hidden h-11 w-11 items-center justify-center md:inline-flex' aria-label='Filtrar relatos'>
								<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
									<path d='M4 7h16M7 12h10M10 17h4'></path>
								</svg>
							</button>
						</div>
						<div data-profile-tab-panel='stories' role='tabpanel'>
							<div data-profile-story-list class='grid gap-6'></div>
						</div>
						<div data-profile-tab-panel='likes' role='tabpanel' class='hidden'>
							<div data-profile-liked-story-list class='grid gap-6'></div>
						</div>
					</section>
				</section>
			</section>

			<section data-profile-settings-sheet class='profile-settings-sheet hidden' aria-hidden='true'>
				<div data-profile-settings-backdrop class='profile-settings-backdrop'></div>
				<div class='profile-settings-panel'>
					<div class='mb-5 flex items-center justify-between gap-3'>
						<div>
							<p class='home-section-kicker'>Ajustes</p>
							<h2 class='profile-section-title mt-2'>Tu cuenta</h2>
						</div>
						<button type='button' data-profile-settings-close class='auth-helper-link'>Cerrar</button>
					</div>

					<div class='profile-settings-sections'>
						<section class='profile-settings-block'>
							<div class='profile-settings-block-head'>
								<h3 class='profile-settings-heading'>Perfil</h3>
								<p class='profile-settings-copy'>Tu firma publica, avatar y bio.</p>
							</div>

							<form data-profile-form class='grid gap-4 md:grid-cols-2'>
								<label class='block md:col-span-1'>
									<span class='auth-field-label'>Nombre visible</span>
									<input data-profile-edit-display-name type='text' class='auth-input w-full' />
								</label>
								<label class='block md:col-span-1'>
									<span class='auth-field-label'>Username</span>
									<input data-profile-edit-username type='text' class='auth-input w-full lowercase' />
								</label>
								<label class='block md:col-span-2'>
									<span class='auth-field-label'>Foto de perfil</span>
									<div class='profile-photo-editor'>
										<div class='profile-photo-preview'>
											<img data-profile-edit-avatar-preview class='profile-photo-preview-image hidden' alt='Vista previa de avatar' />
											<div data-profile-edit-avatar-preview-fallback class='profile-photo-preview-fallback'>P</div>
										</div>
										<div class='flex-1 space-y-3'>
											<input data-profile-edit-avatar type='hidden' />
											<input data-profile-edit-avatar-file type='file' accept='image/*' class='hidden' />
											<div class='flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center'>
												<button type='button' data-profile-avatar-upload class='home-secondary-button rounded-full px-5 py-3 text-sm font-semibold uppercase tracking-[0.08em]'>
													Subir foto
												</button>
												<button type='button' data-profile-avatar-clear class='auth-helper-link text-left'>
													Quitar foto
												</button>
											</div>
											<p class='profile-settings-copy'>El lapiz del avatar abre directamente este selector de imagen.</p>
										</div>
									</div>
								</label>
								<label class='block md:col-span-2'>
									<span class='auth-field-label'>Bio</span>
									<textarea data-profile-edit-bio rows='4' class='auth-input min-h-32 w-full resize-y py-4'></textarea>
								</label>
								<div class='md:col-span-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between'>
									<p data-profile-form-status class='write-status-copy'>Edita tu firma publica y guarda cuando quieras.</p>
									<button type='submit' class='write-publish-button'>Guardar perfil</button>
								</div>
							</form>
						</section>

						<section class='profile-settings-block'>
							<div class='profile-settings-block-head'>
								<h3 class='profile-settings-heading'>Apariencia</h3>
								<p class='profile-settings-copy'>Preferencia visual para la app.</p>
							</div>
							<div class='profile-theme-row'>
								<button type='button' data-theme-choice='night' class='profile-theme-choice'>Modo nocturno</button>
								<button type='button' data-theme-choice='day' class='profile-theme-choice'>Modo claro</button>
							</div>
						</section>

						<section class='profile-settings-block'>
							<div class='profile-settings-block-head'>
								<h3 class='profile-settings-heading'>Privacidad</h3>
								<p class='profile-settings-copy'>Este bloque queda listo para meter visibilidad, bloqueo y permisos cuando lo bajemos a producto.</p>
							</div>
						</section>
					</div>
				</div>
			</section>

			<nav class='home-bottom-nav md:hidden' aria-label='Navegacion principal'>
				{
					bottomNavItems.map((item) => (
						<a
							href={item.href}
							data-profile-link={item.dynamicProfile ? 'true' : undefined}
							class:list={['home-bottom-link', item.active && 'is-active']}
						>
							<svg
								viewBox='0 0 24 24'
								class='h-5 w-5'
								fill='none'
								stroke='currentColor'
								stroke-width='1.9'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d={item.icon}></path>
							</svg>
							<span>{item.label}</span>
						</a>
					))
				}
			</nav>
		</div>
	</main>

	<script>
		import { initProfilePage } from '../scripts/profile-page.ts';
		import { initAuthPortal } from '../scripts/auth-portal.ts';

		initProfilePage();
		initAuthPortal();
	</script>
</Layout>
