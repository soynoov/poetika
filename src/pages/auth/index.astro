---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title='Poetika - Acceso'
	description='Accede a Poetika para publicar, votar y construir tu perfil.'
>
	<main class='home-screen min-h-screen' data-auth-page>
		<section class='auth-shell mx-auto flex min-h-screen max-w-[1180px] items-start justify-center px-5 pb-16 pt-18 sm:px-6 lg:px-8'>
			<div data-auth-portal class='auth-portal-card w-full max-w-[26rem]'>
				<div class='text-center'>
					<a href='/' class='auth-brand'>Poetika</a>
					<p class='auth-tagline'>Donde las palabras cobran vida</p>
				</div>

				<section data-auth-status-card data-tone='neutral' class='auth-status-banner mt-8'>
					<p data-auth-session-state class='auth-status-title'>Sesion cerrada</p>
					<p data-auth-status class='auth-status-copy'>Portal listo.</p>
					<p data-auth-hint class='auth-status-hint hidden'>
						Si la confirmacion por email esta activa, vuelve despues de verificar el correo.
					</p>
					<div data-auth-active-session class='mt-4 hidden gap-3 sm:flex-row'>
						<button type='button' data-auth-go-profile-secondary class='write-publish-button w-full'>
							Ir a mi perfil
						</button>
						<button type='button' data-auth-sign-out class='home-secondary-button w-full rounded-full px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em]'>
							Cerrar sesion
						</button>
					</div>
				</section>

				<div data-auth-forms class='mt-6'>
					<div class='auth-panel'>
						<div class='auth-tab-strip'>
							<button type='button' data-auth-tab-button='sign-in' class='auth-tab-button is-active'>Entrar</button>
							<button type='button' data-auth-tab-button='sign-up' class='auth-tab-button'>Registrarte</button>
						</div>

						<div data-auth-panel='sign-in' class='mt-7'>
							<form data-sign-in-form novalidate class='space-y-5'>
								<label class='block'>
									<span class='auth-field-label'>Email</span>
									<input data-sign-in-email type='email' required autocomplete='email' placeholder='tu@poema.com' class='auth-input w-full' />
								</label>
								<label class='block'>
									<div class='mb-2 flex items-center justify-between gap-3'>
										<span class='auth-field-label'>Contrasena</span>
										<button type='button' data-auth-forgot-password class='auth-helper-link'>Olvidaste?</button>
									</div>
									<input data-sign-in-password type='password' required autocomplete='current-password' placeholder='........' class='auth-input w-full' />
								</label>
								<button type='submit' class='write-publish-button w-full'>Entrar</button>
							</form>

							<div class='auth-divider'>
								<span>O continua con</span>
							</div>

							<button type='button' data-google-sign-in class='auth-google-button'>
								<span class='text-[1.4rem] leading-none text-[#ea4335]'>G</span>
								<span>Continuar con Google</span>
							</button>

							<button type='button' data-auth-switch='sign-up' class='auth-switch-link'>
								No tienes cuenta? Registrate
							</button>
						</div>

						<div data-auth-panel='sign-up' class='mt-7 hidden'>
							<form data-sign-up-form novalidate class='space-y-5'>
								<label class='block'>
									<span class='auth-field-label'>Nombre visible</span>
									<input data-sign-up-display-name type='text' required minlength='2' autocomplete='nickname' placeholder='Tu firma literaria' class='auth-input w-full' />
								</label>
								<label class='block'>
									<span class='auth-field-label'>Username</span>
									<input data-sign-up-username type='text' required minlength='3' maxlength='24' pattern='[a-z0-9_]+' autocomplete='username' placeholder='tuusername' class='auth-input w-full lowercase' />
								</label>
								<label class='block'>
									<span class='auth-field-label'>Email</span>
									<input data-sign-up-email type='email' required autocomplete='email' placeholder='tu@poema.com' class='auth-input w-full' />
								</label>
								<label class='block'>
									<span class='auth-field-label'>Contrasena</span>
									<input data-sign-up-password type='password' required minlength='6' autocomplete='new-password' placeholder='Minimo 6 caracteres' class='auth-input w-full' />
								</label>
								<button type='submit' data-sign-up-submit class='write-publish-button w-full'>
									Crear cuenta
								</button>
							</form>

							<button type='button' data-auth-switch='sign-in' class='auth-switch-link'>
								Ya tienes cuenta? Entrar
							</button>
						</div>
					</div>
				</div>

				<div class='auth-footer'>
					<div class='auth-footer-lines'>
						<span></span>
						<span></span>
					</div>
					<p>Inspiracion nocturna · 2024</p>
				</div>
			</div>
		</section>
	</main>

	<script>
		import { initAuthPortal } from '../../scripts/auth-portal.ts';

		initAuthPortal();
	</script>
</Layout>
