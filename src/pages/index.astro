---
import AppHeader from '../components/AppHeader.astro';
import { getChallengeIcon } from '../lib/challenge-icons';
import KoFiWidget from '../components/KoFiWidget.astro';
import { koFiUrl, koFiWidget } from '../lib/support';
import Layout from '../layouts/Layout.astro';
import { getFallbackDailyChallenge } from '../lib/challenge';

const challenge = getFallbackDailyChallenge();

const bottomNavItems = [
  { href: '/', label: 'Inicio', active: true, icon: 'M3 11.5 12 4l9 7.5M6.5 10.5V20h11V10.5' },
  { href: '/write', label: 'Escribir', active: false, icon: 'M4 6.5h10M4 11.5h10M4 16.5h6M16 14l4-4m0 0 2 2m-2-2-2-2' },
  { href: '/challenge', label: 'Cima', active: false, icon: 'M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm0-8v3l2 1' },
  { href: '/profile', label: 'Perfil', active: false, dynamicProfile: true, icon: 'M12 12a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 12 12Zm-6 8a6 6 0 0 1 12 0Z' },
];
---

<Layout
  title='Poetika - Inicio'
  description='Poetika muestra el reto activo y los relatos publicados en una portada mobile-first con identidad de app.'
>
  <main class='home-screen min-h-screen text-(--ink-strong)'>
    <div class='mx-auto max-w-[1180px] px-0 pb-28 sm:px-6 lg:px-8'>
      <AppHeader currentPath='/' />

      <section
        data-daily-challenge
        class='mx-auto grid max-w-[1100px] gap-12 px-5 pb-10 pt-8 sm:px-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)] lg:items-start'
      >
        <div class='home-hero-copy'>
          <p class='home-eyebrow'>Bienvenido de nuevo</p>
          <h1 class='home-display mt-7 max-w-[13ch]'>
            Tu proxima historia esta <em>esperando ser contada.</em>
          </h1>
        </div>

        <div class='home-challenge-shell'>
          <div class='mb-5 flex items-center justify-between gap-4'>
            <div>
              <p class='home-section-kicker'>Reto del dia</p>
            </div>
            <p class='home-status'>
              <span class='home-status-dot'></span>
              Activo
            </p>
          </div>

          <div class='home-challenge-panel'>
            <div class='space-y-4'>
              {
                challenge.slots.map((slot, index) => {
                  const icon = getChallengeIcon(slot.category);

                  return (
                    <article data-daily-slot={index} class='home-slot-card'>
                      <div class='home-slot-icon'>
                        <svg
                          viewBox='0 0 24 24'
                          class='h-5 w-5'
                          fill='none'
                          stroke='currentColor'
                          stroke-width='1.9'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          aria-hidden='true'
                        >
                          <path data-daily-icon-path d={icon.path} />
                        </svg>
                      </div>

                      <div class='min-w-0 flex-1'>
                        <p data-daily-category class='home-slot-category'>
                          {slot.category}
                        </p>
                        <p data-daily-word class='home-slot-word'>
                          {slot.word}
                        </p>
                        <span data-daily-marker class='hidden'>
                          {slot.marker}
                        </span>
                      </div>

                      <svg
                        viewBox='0 0 24 24'
                        class='h-5 w-5 shrink-0 text-[var(--ink-faint)]'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='1.9'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        aria-hidden='true'
                      >
                        <path d='m9 6 6 6-6 6'></path>
                      </svg>
                    </article>
                  );
                })
              }
            </div>

            <a href='/write' class='home-primary-button mt-5 flex w-full items-center justify-center gap-3 px-6 py-4 text-[0.95rem] font-semibold uppercase tracking-[0.24em]'>
              <svg
                viewBox='0 0 24 24'
                class='h-5 w-5'
                fill='none'
                stroke='currentColor'
                stroke-width='1.9'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d='M14 4h6v6'></path>
                <path d='M10 14 20 4'></path>
                <path d='M20 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4'></path>
              </svg>
              Escribe tu relato
            </a>
          </div>
        </div>
      </section>

      <section class='mx-auto grid max-w-[1100px] gap-8 px-5 pt-3 sm:px-6 lg:grid-cols-[minmax(0,1.05fr)_22rem]'>
        <div>
          <div class='mb-6 flex items-end justify-between gap-4'>
            <div>
              <h2 class='home-section-title'>Libro de hoy</h2>
            </div>
            <a href='/all' class='home-inline-link'>
              Ver todos
            </a>
          </div>

          <div data-story-feed data-feed-mode='home-editorial' class='grid gap-4'></div>
        </div>

        {(koFiUrl || koFiWidget) && (
          <aside class='home-support-card self-start'>
            <div class='home-support-icon'>
              <svg
                viewBox='0 0 24 24'
                class='h-5 w-5'
                fill='none'
                stroke='currentColor'
                stroke-width='1.9'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d='M7 5h10a4 4 0 0 1 0 8H7a3 3 0 1 0 0 6h11'></path>
                <path d='M9 9h8'></path>
              </svg>
            </div>
            <div>
              <p class='home-support-title'>Apoya Poetika</p>
              <p class='home-support-copy'>
                Ayudanos a mantener viva la llama de la creatividad.
              </p>
            </div>

            {koFiWidget ? (
              <KoFiWidget class='kofi-widget-shell mt-2 self-start' />
            ) : (
              <a
                href={koFiUrl}
                target='_blank'
                rel='noreferrer'
                class='home-secondary-button mt-2 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em]'
              >
                Ko-fi support
              </a>
            )}
          </aside>
        )}
      </section>

      <nav class='home-bottom-nav md:hidden' aria-label='Navegacion principal'>
        {
          bottomNavItems.map((item) => (
            <a
              href={item.href}
              data-profile-link={item.dynamicProfile ? 'true' : undefined}
              class:list={['home-bottom-link', item.active && 'is-active']}
            >
              <svg
                viewBox='0 0 24 24'
                class='h-5 w-5'
                fill='none'
                stroke='currentColor'
                stroke-width='1.9'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
              >
                <path d={item.icon}></path>
              </svg>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </main>

  <script>
    import { initDailyChallenge } from '../scripts/daily-challenge.ts';
    import { initStoryFeed } from '../scripts/story-feed.ts';

    initDailyChallenge();
    initStoryFeed();
  </script>
</Layout>
